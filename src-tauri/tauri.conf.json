{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "new_stock",
  "version": "0.1.1",
  "identifier": "com.qrluo.new-stock",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "new_stock",
        "width": 1180,
        "height": 860,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
